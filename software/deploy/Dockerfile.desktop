# Compatibility/render check only, not a Pi display/performance result.
FROM ball-drone-demo:arm64
USER root
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 libegl1 libdbus-1-3 libfontconfig1 fonts-dejavu-core libxkbcommon0 libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 libxcb-shape0 libxcb-xinerama0 && rm -rf /var/lib/apt/lists/*
COPY requirements-desktop.lock requirements.lock /app/
RUN pip install --no-cache-dir -r requirements-desktop.lock
COPY ball_demo /app/ball_demo
ENV QT_QPA_PLATFORM=offscreen
CMD ["python", "-m", "ball_demo.desktop", "--listen", "127.0.0.1", "--snapshot", "/tmp/arm64-desktop.png", "--quit-after", "5"]
