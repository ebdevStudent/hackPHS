        "calibration_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Calibration Id",
          "type": "string"
        },
        "camera_frame": {
          "const": "camera_optical",
          "title": "Camera Frame",
          "type": "string"
        },
        "aircraft_frame": {
          "const": "aircraft_flu",
          "title": "Aircraft Frame",
          "type": "string"
        },
        "image_size": {
          "items": {
            "maximum": 4096,
