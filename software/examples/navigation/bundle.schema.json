            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Minimum",
          "type": "array"
        },
        "maximum": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Maximum",
          "type": "array"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "Box",
      "type": "object"
    },
    "Calibration": {
