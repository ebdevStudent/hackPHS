        "distortion_model": {
          "const": "opencv_brown",
          "title": "Distortion Model",
          "type": "string"
        },
        "distortion": {
          "items": {
            "type": "number"
          },
          "title": "Distortion",
          "type": "array"
        },
        "aircraft_from_camera": {
          "items": {
            "items": {
              "type": "number"
