          "maxItems": 4,
          "minItems": 4,
          "title": "Aircraft From Camera",
          "type": "array"
        },
        "reprojection_rms_px": {
          "minimum": 0,
          "title": "Reprojection Rms Px",
          "type": "number"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
