{
  "$defs": {
    "ArrivalPolicy": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "radius_m": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "title": "Radius M",
          "type": "number"
        },
        "max_uncertainty_m": {
          "default": 0.05,
          "minimum": 0,
          "title": "Max Uncertainty M",
          "type": "number"
        },
        "heading_tolerance_rad": {
          "default": 0.15,
          "exclusiveMinimum": 0,
          "title": "Heading Tolerance Rad",
          "type": "number"
        },
        "angular_uncertainty_rad": {
          "default": 0.05,
          "minimum": 0,
          "title": "Angular Uncertainty Rad",
          "type": "number"
        },
        "dwell_s": {
          "default": 0.15,
          "minimum": 0,
          "title": "Dwell S",
          "type": "number"
        },
        "min_distinct_frames": {
          "default": 3,
          "maximum": 100,
          "minimum": 2,
          "title": "Min Distinct Frames",
          "type": "integer"
        },
        "pose_max_age_s": {
          "default": 0.25,
          "exclusiveMinimum": 0,
          "title": "Pose Max Age S",
          "type": "number"
        }
      },
      "title": "ArrivalPolicy",
      "type": "object"
    },
    "InspectionTarget": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Target Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tag_id": {
          "anyOf": [
            {
              "exclusiveMaximum": 587,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag Id"
        },
        "viewing_position_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Viewing Position M",
          "type": "array"
        },
        "heading_rad": {
          "anyOf": [
            {
              "maximum": 3.141592653589793,
              "minimum": -3.141592653589793,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Rad"
        },
        "arrival": {
          "$ref": "#/$defs/ArrivalPolicy"
        },
        "snapshot": {
          "default": "image",
          "enum": [
            "none",
            "image"
          ],
          "title": "Snapshot",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "name",
        "viewing_position_m"
      ],
      "title": "InspectionTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "mission_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "title": "Mission Id",
      "type": "string"
    },
    "map_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "title": "Map Id",
      "type": "string"
    },
    "map_version": {
      "minimum": 1,
      "title": "Map Version",
      "type": "integer"
    },
    "frame_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "title": "Frame Id",
      "type": "string"
    },
    "survey_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "title": "Survey Id",
      "type": "string"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/InspectionTarget"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Targets",
      "type": "array"
    },
    "example": {
      "title": "Example",
      "type": "boolean"
    },
    "control_authority": {
      "const": "advisory_only",
      "default": "advisory_only",
      "title": "Control Authority",
      "type": "string"
    },
    "physical_output": {
      "const": false,
      "default": false,
      "title": "Physical Output",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "mission_id",
    "map_id",
    "map_version",
    "frame_id",
    "survey_id",
    "targets",
    "example"
  ],
  "title": "Mission",
  "type": "object"
}
