{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator mutation requests v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "const": "follow"
        },
        "payload": {
          "type": "object",
          "properties": {
            "person_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "tag_id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "tag_family": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "person_id",
            "tag_id",
            "tag_family"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "const": "stop"
        },
        "payload": {
          "type": "object",
          "properties": {
            "mission_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "pending_request_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "mission_id",
            "pending_request_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "const": "abort"
        },
        "payload": {
          "type": "object",
          "properties": {
            "mission_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "mission_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "const": "speak"
        },
        "payload": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "voice_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "const": "audio_uplink"
        },
        "payload": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "lease_ms": {
              "enum": [
                0,
                600
              ]
            }
          },
          "required": [
            "enabled",
            "sequence",
            "lease_ms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "const": "land"
        },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "current_position"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "camera_point"
                },
                "frame_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "point": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "mode",
                "frame_id",
                "point"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "apriltag"
                },
                "frame_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "point": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                "tag_id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "tag_family": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "mode",
                "frame_id",
                "point",
                "tag_id",
                "tag_family"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "request_id",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    }
  ]
}
